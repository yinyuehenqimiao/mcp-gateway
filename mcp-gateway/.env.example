# mcp-gateway 本地环境变量样例（仅名称，无真实值）
# 用法：复制为 mcp-gateway/.env 后填写；该文件已被 .gitignore 忽略

# --- HTTP ---
SERVER_PORT=

# --- MySQL（与 docker/.env 中库账号保持一致）---
MYSQL_URL=
MYSQL_USERNAME=
MYSQL_PASSWORD=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=

# --- 网关公开地址 / 默认 slug ---
GATEWAY_PUBLIC_BASE_URL=
GATEWAY_DEFAULT_SERVER_SLUG=
GATEWAY_HTTP_TIMEOUT_MS=

# --- JWT（须与 demo-biz 的 DEMO_JWT_SECRET 相同）---
GATEWAY_JWT_ENABLED=
GATEWAY_JWT_SECRET=

# --- 限流 ---
GATEWAY_RATE_LIMIT_ENABLED=
GATEWAY_RATE_LIMIT_PER_KEY=
GATEWAY_RATE_LIMIT_PER_TOOL=

# --- 审计 RocketMQ（独立 topic，勿占用短链 topic）---
GATEWAY_AUDIT_MQ_ENABLED=
GATEWAY_AUDIT_MQ_TOPIC=
GATEWAY_AUDIT_MQ_CONSUMER_GROUP=
GATEWAY_AUDIT_MQ_SEND_TIMEOUT_MS=
ROCKETMQ_NAME_SERVER=
ROCKETMQ_MCP_AUDIT_PRODUCER_GROUP=
